# FastAPI Application Settings
PROJECT_NAME="Naviora AI"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours
REFRESH_TOKEN_EXPIRE_MINUTES=10080 # 7 days

# Database Configurations
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=naviora_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/naviora_db

# Redis Configurations
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# RabbitMQ / Celery Configurations
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# AI Models & Services Settings
OLLAMA_BASE_URL=http://localhost:11434
WHISPER_API_URL=http://localhost:8000/stt
PIPER_API_URL=http://localhost:8000/tts

# Notification Services
FIREBASE_CREDENTIALS_PATH=app/core/firebase-credentials.json
