{
  "version": 2,
  "buildCommand": "cd frontend && npm ci && npx expo export --platform web",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://naviora-backend-s6je.onrender.com/api/$1",
      "headers": {
        "x-forwarded-host": "naviora-backend-s6je.onrender.com"
      }
    },
    {
      "src": "/_expo/(.*)",
      "dest": "/_expo/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "EXPO_PUBLIC_API_URL": "https://naviora-backend-s6je.onrender.com",
    "EXPO_PUBLIC_WS_URL": "wss://naviora-backend-s6je.onrender.com/api/v1/stream",
    "EXPO_PUBLIC_ENV": "production"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
