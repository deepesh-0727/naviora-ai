# =========================================================
# NAVIORA AI — Environment Template
# Copy this to .env and fill in the values
# =========================================================

# Application
PROJECT_NAME="Naviora AI"
API_V1_STR="/api/v1"
SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database — Supabase Session Pooler
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Services
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
WHISPER_API_URL=http://localhost:8000/stt
PIPER_API_URL=http://localhost:8000/tts

# Notifications
SMS_API_KEY=""
SMS_SENDER="NAVIORA"
EMAIL_API_KEY=""
EMAIL_FROM="noreply@naviora.ai"
FIREBASE_CREDENTIALS=""

# Payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Monitoring
SENTRY_DSN=""